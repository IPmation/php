{
    "name": "ipmation/ipmation",
    "description": "A PHP library for IP, WHOIS, and DNS lookups via public APIs",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "IPmation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IPmation\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "IPmation"
        }
    ],
    "homepage": "https://www.ipmation.com"
}
